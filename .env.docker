# =======================================================
# .env.docker — Environment variable template
#
# Copy this file to .env and fill in all REQUIRED values
# before running the container.
#
# Secrets (API keys, passwords) are intentionally blank.
# Non-secret defaults (endpoints, versions, paths) are
# pre-filled where safe to do so.
#
# For local docker compose runs, PostgreSQL vars marked
# "overridden by docker-compose.yml" do not need to be
# filled — docker-compose.yml injects the local pgvector
# credentials automatically.
# =======================================================


# -------------------------------------------------------
# LangSmith — observability & tracing (optional)
# -------------------------------------------------------
LANGSMITH_TRACING=false                                   # OPTIONAL — set to true to enable LangSmith tracing
LANGSMITH_ENDPOINT=https://api.smith.langchain.com        # OPTIONAL
LANGSMITH_API_KEY=                                        # OPTIONAL — LangSmith API key
LANGSMITH_PROJECT=chatbot                                 # OPTIONAL


# -------------------------------------------------------
# Azure OpenAI Service — fallback chat models + embedding
# The chat models (fast/smart) are inactive when
# azure_ai_foundry is the default provider. The embedding
# endpoint is always active.
# -------------------------------------------------------
AZURE_OPENAI_ENDPOINT=                                    # REQUIRED — Azure OpenAI resource endpoint
AZURE_OPENAI_API_KEY=                                     # REQUIRED — Azure OpenAI API key
AZURE_OPENAI_API_VERSION=2024-12-01-preview               # REQUIRED


# -------------------------------------------------------
# Azure AI Foundry — active chat provider
# Validated by entrypoint.sh on every container start.
# -------------------------------------------------------
AZURE_AI_FOUNDRY_API_KEY=                                 # REQUIRED — Azure AI Foundry API key
AZURE_AI_FOUNDRY_ENDPOINT=                                # REQUIRED — Azure AI Foundry endpoint URL


# -------------------------------------------------------
# File paths — resolved relative to the container workdir
# (/app). These defaults match the Dockerfile layout and
# do not need to change unless you move the files.
# -------------------------------------------------------
ROUTER_PROMPT_PATH=src/ai_agentic_chatbot/prompts/router_prompts.md   # REQUIRED
SCHEMA_PATH=temp/schema_documentation.yaml                            # REQUIRED — written by /schemaText
SCHEMA_SUMMARY_PATH=temp/schema_summary.json                          # OPTIONAL — written by generate_schema_summary(); used for router hints
SYSTEM_PROMPT_PATH=src/ai_agentic_chatbot/prompts/system_prompt.md    # REQUIRED


# -------------------------------------------------------
# MySQL — inactive datasource (PostgreSQL is default)
# Only needed if MySQL is re-enabled in config.yaml.
# -------------------------------------------------------
MYSQL_HOST=                                               # OPTIONAL
MYSQL_PORT=3306                                           # OPTIONAL
MYSQL_DB=                                                 # OPTIONAL
MYSQL_USER=                                               # OPTIONAL
MYSQL_PASSWORD=                                           # OPTIONAL
MYSQL_SSL_CA=certs/DigiCertGlobalRootG2.crt.pem          # OPTIONAL — cert ships in the image


# -------------------------------------------------------
# PostgreSQL — active datasource
# For local docker compose: these are overridden by
# docker-compose.yml (POSTGRESQL_HOST=pgvector, etc.)
# and do not need to be filled for local runs.
# For Azure VM production: fill all five values.
# -------------------------------------------------------
POSTGRESQL_HOST=                                          # REQUIRED (prod) | overridden by docker-compose.yml (local)
POSTGRESQL_PORT=5432                                      # REQUIRED (prod) | overridden by docker-compose.yml (local)
POSTGRESQL_DB=ai_chatbot_db                               # REQUIRED (prod) | overridden by docker-compose.yml (local)
POSTGRESQL_USER=                                          # REQUIRED (prod) | overridden by docker-compose.yml (local)
POSTGRESQL_PASSWORD=                                      # REQUIRED (prod) | overridden by docker-compose.yml (local)
POSTGRESQL_SSLMODE=require                                # OPTIONAL — defaults to "require"; overridden to "disable" by docker-compose.yml for local


# -------------------------------------------------------
# Embedding model — Azure OpenAI (always active)
# Validated by entrypoint.sh on every container start.
# -------------------------------------------------------
EMBEDDING_MODEL_NAME=text-embedding-3-small               # REQUIRED
EMBEDDING_API_KEY=                                        # REQUIRED — Azure OpenAI embedding API key
EMBEDDING_ENDPOINT=                                       # REQUIRED — Azure OpenAI embedding endpoint
EMBEDDING_API_VERSION=2024-02-01                          # REQUIRED
EMBEDDING_TIMEOUT=60                                      # OPTIONAL
EMBEDDING_MAX_RETRIES=3                                   # OPTIONAL


# -------------------------------------------------------
# Vector store
# -------------------------------------------------------
VECTOR_COLLECTION_NAME=db_schema_vectors                  # OPTIONAL — pgvector collection name